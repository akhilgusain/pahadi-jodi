# Copy to .env and fill in. Never commit .env.
# ---- Database (local defaults work with docker-compose) ----
DB_URL=jdbc:postgresql://localhost:5432/pahadijodi
DB_USER=pj
DB_PASSWORD=pj_local_only
# ---- Messaging / cache ----
KAFKA_BOOTSTRAP=localhost:9092
REDIS_HOST=localhost
# ---- Auth ----
# PKCS#8 RSA private key (PEM, newlines as \n or multi-line). Empty = ephemeral dev key.
# Generate: openssl genpkey -algorithm RSA -pkey_opt rsa_keygen_bits:2048
PJ_JWT_PRIVATE_KEY_PEM=
PJ_JWT_ISSUER=http://localhost:8081
PJ_JWKS_URI=http://localhost:8081/.well-known/jwks.json
PJ_CORS_ORIGINS=http://localhost:5173
# ---- To be added later (not used by the skeleton yet) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
FCM_SERVICE_ACCOUNT_JSON=
MSG91_AUTH_KEY=
WHATSAPP_ACCESS_TOKEN=
AWS_REGION=ap-south-1
